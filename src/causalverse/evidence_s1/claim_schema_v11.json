{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "snapshot_sha256",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "s1.1-claims-1"
    },
    "context_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim_type",
          "evidence_refs"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "claim_type": {
            "enum": [
              "FACT",
              "COMPARISON",
              "RELATION",
              "INSUFFICIENT_EVIDENCE"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id",
                "fact_id",
                "payload_sha256"
              ],
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                },
                "fact_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "payload_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "comparison_basis": {
            "const": "DIFFERENCE"
          },
          "relation_level": {
            "enum": [
              "VALIDATED_PATH",
              "STATISTICAL_ASSOCIATION",
              "CANDIDATE_RELATION",
              "HYPOTHESIS"
            ]
          }
        }
      }
    }
  }
}